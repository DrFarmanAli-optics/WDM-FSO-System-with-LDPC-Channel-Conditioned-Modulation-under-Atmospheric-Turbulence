function LdB = rainITU_P838(rate_mmph, lambda_nm, d_km)
% ITU-R P.838 specific attenuation: gammaR = k R^alpha (dB/km)
% k, alpha depend on frequency (approx via 1550nm ~ 193.5 THz -> use high-freq optics proxy)
% For optical, empirical fits are used; here adopt common near-IR fit:
R = max(rate_mmph, 0);
k = 1.076; alpha = 0.67; % literature-based optical fit at 1550 nm
gammaR = k * R.^alpha;   % dB/km
LdB = gammaR .* d_km;
end
