function LdB = geometryLoss(txAper_m, rxAper_m, lambda_nm, d_km)
% Geometric spreading/aperture coupling (Friis-like for optics)
lambda = lambda_nm*1e-9; d = d_km*1e3;
% Far-field diffraction-limited divergence ~ 1.22*lambda/Dtx; spot > Drx
theta = 1.22*lambda/txAper_m;
spot = theta*d;
capture = min(1, (rxAper_m/2)^2 / ( (spot/2)^2 )); % area ratio approx
LdB = -10*log10(capture);
end
