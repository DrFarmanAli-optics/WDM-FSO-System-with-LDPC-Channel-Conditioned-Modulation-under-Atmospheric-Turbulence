function LdB = fogITU_P840(visibility_km, lambda_nm, d_km)
% ITU-R P.840/Kim model: gamma = (3.912/Vis) * (lambda/0.55um)^(-q)
Vis = max(visibility_km, 0.05);
lambda_um = lambda_nm/1000;
if Vis > 50, q = 1.6;
elseif Vis >= 6, q = 1.3;
elseif Vis >= 1, q = 0.16*Vis + 0.34;
else, q = Vis - 0.5;
end
gamma = (3.912/Vis) * (lambda_um/0.55)^(-q); % dB/km
LdB = gamma * d_km;
end
