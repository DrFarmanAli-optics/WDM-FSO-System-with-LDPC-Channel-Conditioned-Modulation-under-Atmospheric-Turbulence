%test
tests/test_basic.m
function test_basic
C = cfg.defaultConfig(); C.sim.verbose=false; C.wdm.symbolsPerChan=2e4;
R = link.simulateFSOLink(C);
assert(isfinite(R.BER) && R.BER>=0 && R.BER<=1);
fprintf('Test OK. BER=%.2e SNR=%.1f dB\n', R.BER, R.SNRdB);
end

