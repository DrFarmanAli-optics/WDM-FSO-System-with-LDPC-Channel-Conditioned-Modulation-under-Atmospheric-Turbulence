% main.m
clc; clear; close all;

C = cfg.defaultConfig();

% Single run at nominal weather to sanity-check chain
results = link.simulateFSOLink(C);

fprintf('M=%d, Rrain=%.1f mm/h, Cn2=%.1e => BER=%.3e, SNR=%.1f dB\n', ...
    C.mod.M, C.weather.rainRate, C.turb.Cn2, results.BER, results.SNRdB);

% Example sweep
addpath scripts; 
scripts.ber_vs_rain;   % produces BER vs rain plot & saves CSV/PNG
